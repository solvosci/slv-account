    </record>

    <record id="action_move_out_invoice_type_group_evaluation" model="ir.actions.server">
        <field name="name">Customer Invoices (group evaluation)</field>
        <field name="state">code</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="code">
            action = env['account.move'].with_user(env.user)._get_action_move_out_invoice_type_group_evaluation()
        </field>
    </record>

    <record id="account.menu_action_move_out_invoice_type" model="ir.ui.menu">
        <field name="action" ref="action_move_out_invoice_type_group_evaluation" />
    </record>


