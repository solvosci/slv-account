<odoo>

    <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
        <field name="context">{'default_move_type': 'out_invoice', 'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <record id="account.action_move_out_refund_type" model="ir.actions.act_window">
        <field name="context">{'default_move_type': 'out_refund', 'display_account_trust': True, 'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
        <field name="context">{'default_move_type': 'in_invoice', 'display_account_trust': True,'create': False, 'edit': False, 'delete': False}</field>
    </record>

