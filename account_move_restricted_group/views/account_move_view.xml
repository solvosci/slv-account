        <field name="context">{'default_move_type': 'in_refund', 'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <record id="account.action_move_journal_line" model="ir.actions.act_window">
        <field name="context">{'default_move_type': 'entry', 'search_default_posted':1, 'view_no_maturity': True, 'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <record id="account.action_account_moves_all" model="ir.actions.act_window">
