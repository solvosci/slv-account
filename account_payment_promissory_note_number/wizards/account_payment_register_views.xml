<odoo>

    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account_payment_promissory_note.view_account_payment_form_multi"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='promissory_note']" position="after">
                <field name="promissory_note_number" invisible="promissory_note == False"/>
            </xpath>
        </field>
    </record>

</odoo>
