<odoo>
    <record id="view_invoice_tree" model="ir.ui.view">
        <field name="name">account.invoice.tree (in account_move_purchase_date_origin)</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <field name="invoice_origin" position="after">
                <field
                    name="purchase_date_origin"
                    optional="show"
                    string="Purchase Date"
                    column_invisible="context.get('default_move_type') not in ('in_invoice', 'in_refund')"
                />
            </field>
        </field>
    </record>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.invoice.form (in account_move_purchase_date_origin)</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']/field[@name='date']" position="after">
                <field
                    name="purchase_date_origin"
                    string="Purchase Date"
                    invisible="move_type not in ('in_invoice', 'in_refund')"
                />
            </xpath>
        </field>
    </record>
</odoo>
