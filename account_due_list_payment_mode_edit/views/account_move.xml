<odoo>
    <record id="account_move_payments" model="ir.ui.view">
        <field name="name">account.move.payments</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_payments"
                    class="oe_stat_button"
                    type="object"
                    icon="fa-list"
                    invisible="payments_count == 0 or state not in ['posted']"
                    >
                    <field name="payments_count" widget="statinfo" string="Payments"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
