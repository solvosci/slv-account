#. module: account_invoice_account_group_checked
#: model:ir.model,name:account_invoice_account_group_checked.model_account_group
msgid "Account Group"
msgstr "Grupo de cuenta"

#. module: account_invoice_account_group_checked
#: model:ir.model.fields,field_description:account_invoice_account_group_checked.field_account_move__has_account_checked_group
msgid "Has Account Checked Group"
msgstr "Está en los grupos de cuentas marcados"

#. module: account_invoice_account_group_checked
#: model_terms:ir.ui.view,arch_db:account_invoice_account_group_checked.view_account_invoice_filter_inherit_checked
msgid "Has Checked Account Group"
msgstr "Está en los grupos marcados"

#. module: account_invoice_account_group_checked
#: model_terms:ir.ui.view,arch_db:account_invoice_account_group_checked.view_account_invoice_filter_inherit_checked
msgid "Has No Checked Account Group"
msgstr "No está en los grupos marcados"

#. module: account_invoice_account_group_checked
#: model:ir.model.fields,help:account_invoice_account_group_checked.field_account_group__will_check_invoice
msgid ""
"If checked, any invoice that has a line using an account belonging to this "
"group will be flagged through the \"Has Account Checked Group\" field on "
"the invoice."
msgstr ""
"Si está marcado, cualquier factura que tenga una línea que use una cuenta "
"contable que pertenezca a este grupo será marcada a través del campo \"Está "
"en los grupos de cuentas marcados\" de la factura."

#. module: account_invoice_account_group_checked
#: model:ir.model,name:account_invoice_account_group_checked.model_account_move
msgid "Journal Entries"
msgstr "Asientos contables"

#. module: account_invoice_account_group_checked
#: model:ir.model.fields,help:account_invoice_account_group_checked.field_account_move__has_account_checked_group
msgid ""
"True if at least one invoice line uses an account belonging to an account "
"group flagged as \"Will Check Invoice\"."
msgstr ""
"Es verdadero si, al menos, una de las líneas de factura usa una cuenta que "
"pertenezca a un grupo de cuentas que tenga marcado el check \"Activa marca "
"en facturas\"."

#. module: account_invoice_account_group_checked
#: model:ir.model.fields,field_description:account_invoice_account_group_checked.field_account_group__will_check_invoice
msgid "Will Check Invoice"
msgstr "Activa marca en facturas"
