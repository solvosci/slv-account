<odoo>
    <record id="view_move_line_tree_inherit" model="ir.ui.view">
        <field name="name">account.move.line.tree.analytic.distribution (in account_analytic_distribution)</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='analytic_distribution']" position="after" >
                <field name="first_analytic_account_id" optional="show" groups="analytic.group_analytic_accounting"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.analytic.distribution (in account_analytic_distribution)</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='analytic_distribution']" position="after" >
                <field name="first_analytic_account_id" optional="show" groups="analytic.group_analytic_accounting"/>
            </xpath>
        </field>
    </record>
</odoo>
